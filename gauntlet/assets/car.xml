<!--
  The Gauntlet robot, modeled on the Rubik Pi platform:
  ~22 x 16 cm, ~1 kg, Ackermann steering, rear-wheel drive.

  Sensors match the competition rules: a forward camera (the primary sensor),
  an IMU, and wheel encoders. Depth sensors (lidar, ToF, ultrasonic, stereo)
  are PROHIBITED by the rules, so none are modeled — obstacle detection must
  come from the camera.

  Included into gauntlet.xml inside <worldbody>; actuators/sensors live there.
-->
<mujoco>
  <body name="car" pos="0 0 0.052">
    <freejoint name="car_free"/>
    <site name="imu" pos="0 0 0" size="0.005" rgba="1 0 0 0.5" group="4"/>

    <!-- chassis -->
    <geom name="chassis" type="box" size="0.11 0.07 0.02" pos="0 0 0.015"
          mass="0.85" rgba="0.15 0.35 0.75 1"/>
    <geom name="board" type="box" size="0.045 0.05 0.012" pos="-0.02 0 0.047"
          mass="0.08" rgba="0.1 0.5 0.2 1"/>

    <!-- onboard camera: pitched ~20 deg down to see the line and the horizon -->
    <camera name="onboard" pos="0.10 0 0.075" xyaxes="0 -1 0  0.342 0 0.940" fovy="78"/>
    <geom name="camera_body" type="box" size="0.01 0.012 0.01" pos="0.10 0 0.075"
          mass="0.01" rgba="0.15 0.15 0.15 1"/>

    <!-- front left: steering knuckle + wheel -->
    <body name="fl_knuckle" pos="0.075 0.07 0">
      <inertial pos="0 0 0" mass="0.02" diaginertia="2e-6 2e-6 2e-6"/>
      <joint name="fl_steer" type="hinge" axis="0 0 1" range="-0.55 0.55" damping="0.01"/>
      <body name="fl_wheel">
        <joint name="fl_roll" type="hinge" axis="0 1 0" damping="0.0005"/>
        <geom name="fl_tire" type="cylinder" size="0.032 0.012" zaxis="0 1 0"
              mass="0.03" rgba="0.1 0.1 0.1 1" friction="1.3 0.005 0.0001"/>
      </body>
    </body>

    <!-- front right: steering knuckle + wheel -->
    <body name="fr_knuckle" pos="0.075 -0.07 0">
      <inertial pos="0 0 0" mass="0.02" diaginertia="2e-6 2e-6 2e-6"/>
      <joint name="fr_steer" type="hinge" axis="0 0 1" range="-0.55 0.55" damping="0.01"/>
      <body name="fr_wheel">
        <joint name="fr_roll" type="hinge" axis="0 1 0" damping="0.0005"/>
        <geom name="fr_tire" type="cylinder" size="0.032 0.012" zaxis="0 1 0"
              mass="0.03" rgba="0.1 0.1 0.1 1" friction="1.3 0.005 0.0001"/>
      </body>
    </body>

    <!-- rear wheels: driven -->
    <body name="rl_wheel" pos="-0.075 0.07 0">
      <joint name="rl_roll" type="hinge" axis="0 1 0" damping="0.0005"/>
      <geom name="rl_tire" type="cylinder" size="0.032 0.012" zaxis="0 1 0"
            mass="0.03" rgba="0.1 0.1 0.1 1" friction="1.3 0.005 0.0001"/>
    </body>
    <body name="rr_wheel" pos="-0.075 -0.07 0">
      <joint name="rr_roll" type="hinge" axis="0 1 0" damping="0.0005"/>
      <geom name="rr_tire" type="cylinder" size="0.032 0.012" zaxis="0 1 0"
            mass="0.03" rgba="0.1 0.1 0.1 1" friction="1.3 0.005 0.0001"/>
    </body>
  </body>
</mujoco>
